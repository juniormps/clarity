# Variáveis de ambiente do cliente (Vite).
#
# Variáveis com o prefixo VITE_ são incorporadas à build no momento em que ela
# é gerada (npm run build). Elas são PÚBLICAS: qualquer pessoa que acesse a
# aplicação pode visualizá-las. Nunca coloque segredos, tokens, credenciais ou
# senhas aqui.

# URL base da API.
# - Em desenvolvimento, deixe vazio para usar caminhos relativos `/api`
#   (o Vite faz o proxy para http://localhost:3000).
# - Em produção, informe a URL completa da API, por exemplo:
#   VITE_API_URL=https://api.exemplo.com
#
# O valor é definido no momento da build e não pode ser alterado em runtime.
VITE_API_URL=
