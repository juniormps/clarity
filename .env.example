# Variáveis de ambiente do servidor.
#
# O servidor lê estas variáveis em runtime a partir deste arquivo (na raiz do
# projeto). Elas podem conter informações sensíveis e NUNCA são expostas ao
# cliente.

# --- Servidor ---

# Porta em que o servidor escuta. Opcional (padrão: 3000).
PORT=3000

# Ambiente de execução. Opcional (padrão: development).
# Valores aceitos: development | test | production.
# Em produção, defina "production" explicitamente (ex.: NODE_ENV=production
# node dist/server.js), pois é o que habilita o cookie Secure da sessão.
NODE_ENV=development

# Origem do frontend autorizado a consumir a API pelo navegador (CORS).
# - Em desenvolvimento/teste, pode ficar vazio: o padrão é
#   http://localhost:5173 (origem local do Vite).
# - Em produção é OBRIGATÓRIA e deve ser a URL do frontend, sem barra final.
#   Exemplo: CLIENT_ORIGIN=https://appclarity.vercel.app
CLIENT_ORIGIN=

# --- Banco de dados (MySQL) ---

# As variáveis abaixo são OBRIGATÓRIAS (não possuem valor padrão).

# Host do MySQL.
DB_HOST=localhost

# Porta do MySQL.
DB_PORT=3306

# Usuário do MySQL.
DB_USER=

# Senha do usuário do MySQL. Não informe valores reais aqui.
DB_PASSWORD=

# Nome do banco de dados.
DB_NAME=clarity

# Caminho opcional para o certificado CA utilizado pela conexão MySQL TLS.
# Necessário quando o provedor do banco exige validação por CA.
# DB_SSL_CA_PATH=/caminho/para/ca.pem

# --- Testes E2E (opcional) ---

# Nome do banco de dados dedicado aos testes E2E. Opcional (padrão:
# clarity_e2e). Só sobrescreva se necessário; o nome deve terminar em "_e2e".
# E2E_DB_NAME=clarity_e2e
